Windows Registry Editor Version 5.00

; G-SMaRT HRIS - lets a 64-bit program (64-bit PHP / XAMPP, 64-bit PowerShell) use the 32-bit
; zkemkeeper.dll. Windows then runs the DLL in its own 32-bit host process (DllSurrogate, dllhost.exe).
; Import it AFTER register_sdk.bat, by double-clicking this file (administrator rights needed).
; {00853A19-BD51-419B-9269-2DABE57EB61F} is the class CZKEM of zkemkeeper.dll.

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Wow6432Node\CLSID\{00853A19-BD51-419B-9269-2DABE57EB61F}]
"AppID"="{00853A19-BD51-419B-9269-2DABE57EB61F}"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Wow6432Node\AppID\{00853A19-BD51-419B-9269-2DABE57EB61F}]
"DllSurrogate"=""

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\AppID\{00853A19-BD51-419B-9269-2DABE57EB61F}]
"DllSurrogate"=""
